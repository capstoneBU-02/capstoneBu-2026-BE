# 복사해서 사용: cp .env.example .env
# docker compose로 띄울 때는 호스트명이 서비스 이름(postgres, redis, seaweedfs)입니다.
# 로컬에서 uvicorn을 직접 실행할 때는 localhost로 바꾸세요.

# ── 앱 ──────────────────────────────
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── DB (PostgreSQL) ──────────────────
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone
POSTGRES_DB=capstone
DATABASE_URL=postgresql+psycopg://capstone:capstone@postgres:5432/capstone

# ── Redis / Celery ───────────────────
REDIS_URL=redis://redis:6379/0

# ── 파일 저장소 (SeaweedFS, S3 호환) ──
S3_ENDPOINT_URL=http://seaweedfs:8333
# 브라우저가 presigned URL로 접근할 주소 (로컬은 localhost)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=capstone
S3_SECRET_KEY=capstone-secret
S3_BUCKET=capstone
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRES_SECONDS=900
